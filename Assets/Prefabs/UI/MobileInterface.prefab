  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::GravityGame.MobileTutorial
  settings: {fileID: 11400000, guid: 1b2899049045eff4f85de46c56f91294, type: 2}
  copy:
    moveHeading: 1 / 5  STRANDED
    move: 'Your flight is gone. Find a way home.

      Use the left stick. Push farther to run.'
    firstHeading: 2 / 5  JUMP 1
    first: 'Tap JUMP, then land.

      Jumps 1 and 2 stay in gravity.'
    secondHeading: 3 / 5  JUMP 2
    secondGrounded: Tap jump 2 within {remaining}s.
    secondAirborne: 'Wait for the landing pulse.

      Then tap again within {window} seconds.'
    thirdHeading: 4 / 5  JUMP 3
    thirdGrounded: 'Aim at another planet.

      Tap gold JUMP for 3!'
    thirdAirborne: 'Land again, then jump 3.

      Aim at another planet.'
    travelHeading: 5 / 5  TRAVEL
    travel: 'Reach gravity to refill oxygen.

      Blue cape: safe. Red cape: empty.'
    exploreHeading: READY TO EXPLORE
    explore: 'Collect stars to chart your way home.

      Land anywhere. Retry keeps your stars.'
  player: {fileID: 0}
  card: {fileID: 5178226468015483571}
  heading: {fileID: 6948134928399645693}
  instructions: {fileID: 8159895593253501138}
